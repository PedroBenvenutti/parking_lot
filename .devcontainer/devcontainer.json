{
  // Ambiente pronto para o GitHub Codespaces (ou VS Code Dev Containers).
  // Sobe um container com Python + Node e outro com o Postgres.
  "name": "Parking Lot",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Só a 8000: o backend serve a API, o WebSocket e a interface já compilada.
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Parking Lot", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
